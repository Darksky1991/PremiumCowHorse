{
  "name": "@pch/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PremiumCowHorse 桌面应用（Electron 主进程 / preload / 渲染端）",
  "productName": "PremiumCowHorse",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:zip": "pnpm build && electron-builder --win zip"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.4",
    "i18next": "^27.1.3",
    "kysely": "^0.29.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@pch/i18n": "workspace:*",
    "@pch/plugin-sdk": "workspace:*",
    "@pch/shared": "workspace:*",
    "@pch/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cn": "^0.5.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-resizable-panels": "^4.24.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
